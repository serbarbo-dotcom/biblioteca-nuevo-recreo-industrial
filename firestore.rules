rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function administrador() {
      return request.auth != null
        && request.auth.uid == 'Oa6t2E7kF8ejFMbX7di6yQ2uFgF3'
        && request.auth.token.email_verified == true;
    }
    match /libros/{id} {
      allow read: if true;
      allow create, update, delete: if administrador();
    }
    match /noticias/{id} {
      allow read: if true;
      allow create, update, delete: if administrador();
    }
    match /config/busquedas {
      allow read, write: if administrador();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}